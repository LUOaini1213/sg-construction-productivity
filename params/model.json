    "precast_cycle_cut":         {"value": 0.30, "low": 0.15, "high": 0.40, "unit": "fraction of structural floor cycle removed", "kind": "assumption", "note": ""},
    "prefab_mep_time_cut":       {"value": 0.40, "low": 0.20, "high": 0.60, "unit": "fraction of MEP floor time removed", "kind": "assumption", "note": "high end equals the BCA 'up to 60%' figure", "cite": "prefab_mep_time_upper"},
